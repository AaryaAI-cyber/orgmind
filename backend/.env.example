# AMD Developer Cloud (get from developer.amd.com)
AMD_CLOUD_ENDPOINT=your_amd_endpoint_here
AMD_CLOUD_API_KEY=your_amd_api_key_here

# MindsDB (get from mindsdb.com)
MINDSDB_HOST=your_mindsdb_host
MINDSDB_USER=your_mindsdb_user
MINDSDB_PASSWORD=your_mindsdb_password

# App settings
DEMO_MODE=false
CORS_ORIGINS=https://orgmind.vercel.app,http://localhost:3000
